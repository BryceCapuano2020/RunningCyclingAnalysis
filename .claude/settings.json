{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/ops/worktree-sweep.mjs",
            "timeout": 30,
            "statusMessage": "Sweeping finished worktrees"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/ops/pr-queue.mjs --action",
            "timeout": 20,
            "statusMessage": "Reading the PR queue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/ops/agent-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
