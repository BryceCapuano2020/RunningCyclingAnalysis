# Copy to .dev.vars (git-ignored). `wrangler dev` reads it and it overrides [vars] in wrangler.toml.
ENVIRONMENT=development
APP_URL=http://localhost:5183

# Google OAuth client (Web application type). Authorized redirect URI must be:
#   http://localhost:5183/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HMAC key for session cookies. Production uses `wrangler secret put SESSION_SIGNING_KEY` with a
# random value of at least 32 bytes. This fixed value is for local development only.
SESSION_SIGNING_KEY=local-development-only-session-signing-key
