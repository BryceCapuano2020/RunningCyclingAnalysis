{
  "name": "@rca/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Analysis library: FIT decoding, metabolic model, duration curves and the run-versus-ride comparison. Pure TypeScript, no DOM.",
  "exports": {
    "./types": "./src/types.ts",
    "./constants": "./src/constants.ts",
    "./customRange": "./src/customRange.ts",
    "./digest": "./src/digest/index.ts",
    "./digest/modelRevision": "./src/digest/modelRevision.ts",
    "./digest/trendPoints": "./src/digest/trendPoints.ts",
    "./duplicates": "./src/duplicates.ts",
    "./math": "./src/math.ts",
    "./pipeline": "./src/pipeline.ts",
    "./period": "./src/period.ts",
    "./predict": "./src/predict/index.ts",
    "./profile": "./src/profile/index.ts",
    "./session": "./src/session.ts",
    "./compare": "./src/compare/index.ts",
    "./cp": "./src/cp/index.ts",
    "./curves": "./src/curves/index.ts",
    "./effort": "./src/effort/index.ts",
    "./fit": "./src/fit/index.ts",
    "./gpx": "./src/gpx/index.ts",
    "./gpx/encode": "./src/gpx/encode.ts",
    "./grade": "./src/grade/index.ts",
    "./hr": "./src/hr/index.ts",
    "./import": "./src/import/index.ts",
    "./metabolic": "./src/metabolic/index.ts",
    "./quality": "./src/quality/index.ts",
    "./records": "./src/records/index.ts",
    "./route/routeShape": "./src/route/routeShape.ts",
    "./sha256": "./src/sha256.ts",
    "./synthetic": "./src/synthetic/index.ts",
    "./tcx": "./src/tcx/index.ts",
    "./tcx/encode": "./src/tcx/encode.ts",
    "./units": "./src/units/index.ts",
    "./virtualPower": "./src/virtualPower/index.ts",
    "./xml": "./src/xml/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.corpus.json --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.218.0"
  }
}
