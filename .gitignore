# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# tests
coverage
playwright-report
test-results

# personal activity data never gets committed
data/
*.fit
# Third-party test files with their licences (packages/core/test-corpus/README.md) are not personal.
!packages/core/test-corpus/**/*.fit
*.fit.gz
!**/fixtures/*.fit
!**/e2e/fixtures/*.fit
!**/e2e/fixtures/*.zip
.claude/

# local Worker secrets and Wrangler state
.dev.vars
.wrangler

# Python bytecode from the data scripts
__pycache__/
*.pyc
