{
  "name": "running-cycling-analysis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @rca/web",
    "dev:api": "npm run dev -w @rca/api",
    "build": "npm run build -w @rca/web",
    "lint": "oxlint --deny-warnings",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=11 && vitest run --sequence.shuffle --sequence.seed=22",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "npm run test:perf -w @rca/core && npm run test:perf -w @rca/web",
    "test:sim": "npm run test:sim -w @rca/core",
    "benchmark:core": "node --import tsx packages/core/benchmarks/library.ts",
    "e2e": "npm run e2e -w @rca/web",
    "deploy": "node scripts/ops/check-release.mjs && npm run verify:release && npm run deploy:built -w @rca/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:sim && npm run test:deploy-config && npm run test:ops && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/ops/check-bundle-size.mjs",
    "test:ops": "node --test scripts/ops/*.test.mjs",
    "test:deploy-config": "node --test apps/api/scripts/check-deploy-config.test.mjs apps/api/scripts/check-migrations.test.mjs apps/api/scripts/prepare-d1-restore.test.mjs",
    "smoke:prod": "node scripts/ops/smoke.mjs",
    "verify:release": "npm run check && npm run e2e && npm run e2e:worker -w @rca/web",
    "deploy:bootstrap": "npm run build && npm run deploy:bootstrap -w @rca/api"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.4",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
